{
  "name": "dhaka-tesla-pool",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack ride-pooling application for Dhaka.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@dhaka-tesla-pool/web",
    "dev:api": "npm run dev --workspace=@dhaka-tesla-pool/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  }
}
